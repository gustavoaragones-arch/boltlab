{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boltlab.io/schemas/dataset.schema.json",
  "title": "BoltLab Engineering Dataset",
  "type": "object",
  "required": [
    "dataset_id",
    "id",
    "title",
    "schema_version",
    "verified",
    "verification_method",
    "primary_sources",
    "last_reviewed",
    "license_notes",
    "units",
    "precision",
    "source_standards",
    "version",
    "created",
    "updated",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "dataset_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string" },
    "schema_version": { "type": "string" },
    "verified": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["verified", "source_bound", "pending_verification", "unavailable"],
      "description": "Optional, additive field (v0.2.0+). Distinguishes dataset-level data-quality state beyond the boolean `verified` flag: VERIFIED (authoritative source identified and value verified, safe for user-facing engineering data products), SOURCE_BOUND (source identified and data exists but normalization/verification is not yet complete), PENDING_VERIFICATION (field/value exists conceptually but no authoritative source has been established), UNAVAILABLE (no value currently available; must not be inferred). Absent on datasets predating this field; such datasets are implicitly VERIFIED when `verified: true`."
    },
    "verification_method": { "type": ["string", "null"] },
    "primary_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_reviewed": { "type": ["string", "null"], "format": "date" },
    "license_notes": { "type": ["string", "null"] },
    "units": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "precision": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ]
      }
    },
    "source_standards": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "records": {
      "type": "array",
      "items": { "type": "object" }
    },
    "derived_candidates": {
      "type": "array",
      "description": "Optional, additive field (v0.2.0+). Mathematical derivations or approximation formulas attributed to an identified source, kept structurally separate from `records` so a derivation can never be mistaken for a verified value. A derived_candidate must never be promoted into `records` or treated as verified without independent confirmation of the specific resulting value.",
      "items": {
        "type": "object",
        "required": ["id", "formula", "description", "source", "status", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "applies_to": { "type": ["string", "null"] },
          "formula": { "type": "string" },
          "description": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" },
          "source_tier": { "type": ["integer", "null"] },
          "calculation_method": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["derived_candidate"] },
          "verified": { "type": "boolean", "enum": [false] },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
