{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boltlab.io/schemas/relationship.schema.json",
  "title": "BoltLab Knowledge Relationship",
  "type": "object",
  "required": [
    "id",
    "source",
    "predicate",
    "target",
    "strength",
    "notes",
    "version",
    "created",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "source": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "predicate": {
      "type": "string",
      "enum": [
        "USES",
        "DEFINED_BY",
        "PART_OF",
        "MEASURED_WITH",
        "COMPARED_WITH",
        "RELATES_TO",
        "DERIVED_FROM",
        "SUPPORTED_BY"
      ]
    },
    "target": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": { "type": "string" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" }
  }
}
